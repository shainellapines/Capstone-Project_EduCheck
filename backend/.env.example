# Copy to backend/.env and fill in. .env itself is gitignored.
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educheck_db
DB_USER=postgres
DB_PASSWORD=change-me
# Any long random string (40+ chars), e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
# Web addresses allowed to call the API, comma-separated, e.g. the frontend
# opened from other computers: http://192.168.1.20:5173
# Leave empty to allow any origin (local development only).
CORS_ORIGIN=
# Database backups (npm run backup). Optional: folder for the .sql files
# (default <home>/EduCheck-db-backups), how many to keep (default 14), and
# pg_dump's full path if it is not found automatically.
BACKUP_DIR=
BACKUP_KEEP=14
PG_DUMP_PATH=
