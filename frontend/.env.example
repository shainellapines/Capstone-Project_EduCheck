# Copy to frontend/.env and fill in. Vite reads these at build/dev time.

# The school's name, shown on the login page. Leave empty to hide it.
VITE_SCHOOL_NAME=

# Address of the EduCheck backend. Leave empty to use http://localhost:5000.
# For UAT on other computers, use the server PC's LAN address,
# e.g. VITE_API_URL=http://192.168.1.20:5000
VITE_API_URL=
